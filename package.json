{
  "name": "promptopskit",
  "version": "0.1.0",
  "description": "Manage prompts, system instructions, tools, and model settings as code",
  "type": "module",
  "bin": {
    "promptopskit": "./dist/cli/index.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./openai": {
      "import": {
        "types": "./dist/providers/openai.d.ts",
        "default": "./dist/providers/openai.js"
      },
      "require": {
        "types": "./dist/providers/openai.d.cts",
        "default": "./dist/providers/openai.cjs"
      }
    },
    "./anthropic": {
      "import": {
        "types": "./dist/providers/anthropic.d.ts",
        "default": "./dist/providers/anthropic.js"
      },
      "require": {
        "types": "./dist/providers/anthropic.d.cts",
        "default": "./dist/providers/anthropic.cjs"
      }
    },
    "./gemini": {
      "import": {
        "types": "./dist/providers/gemini.d.ts",
        "default": "./dist/providers/gemini.js"
      },
      "require": {
        "types": "./dist/providers/gemini.d.cts",
        "default": "./dist/providers/gemini.cjs"
      }
    },
    "./openrouter": {
      "import": {
        "types": "./dist/providers/openrouter.d.ts",
        "default": "./dist/providers/openrouter.js"
      },
      "require": {
        "types": "./dist/providers/openrouter.d.cts",
        "default": "./dist/providers/openrouter.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:serial": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "prompt",
    "llm",
    "ai",
    "openai",
    "anthropic",
    "gemini",
    "prompt-engineering",
    "prompt-management"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PredictabilityAtScale/promptopskit.git"
  },
  "homepage": "https://github.com/PredictabilityAtScale/promptopskit",
  "author": "Predictability at Scale, Inc.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "rimraf": "^6.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.4"
  }
}
